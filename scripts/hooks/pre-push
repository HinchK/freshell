# Freshell pre-push gate — the cheap local checks (cargo fmt, tsc typecheck,
# cargo clippy) plus a targeted cargo test lane for rust changes, filtered by
# what the push actually changes. See docs/development/pre-push-gate.md.
#
# Bypass (emergencies only): git push --no-verify
# Disable for one push:       FRESHELL_PREPUSH=0 git push ...
# Debug routing (run nothing): FRESHELL_PREPUSH_DEBUG=1 git push --dry-run ...
set -u

if [ "${FRESHELL_PREPUSH:-1}" = "0" ]; then
  echo "pre-push: FRESHELL_PREPUSH=0 — gate disabled for this push" >&2
  exit 0
fi

ZERO=0000000000000000000000000000000000000000
changed=""
full_gate=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion — nothing to check.
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch: diff against its merge base with origin/main.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || { full_gate=1; continue; }
  else
    base="$remote_sha"
  fi
  chunk=$(git diff --name-only "$base" "$local_sha" 2>/dev/null) || full_gate=1
  if [ -n "$chunk" ]; then
    changed="${changed}${chunk}
"
  fi
done

run_rust=0
run_ts=0
if [ "$full_gate" = 1 ]; then
  run_rust=1
  run_ts=1
elif [ -n "$changed" ]; then
  printf '%s' "$changed" | grep -Eq '\.rs$|Cargo\.(toml|lock)$|rust-toolchain' && run_rust=1
  printf '%s' "$changed" | grep -Eq '\.(ts|tsx)$|package(-lock)?\.json$|tsconfig' && run_ts=1
fi

# The plan script lives next to this hook (the main checkout's copy —
# core.hooksPath points here, so even worktrees at older commits run the
# current routing logic), while cargo itself runs in the pushing worktree.
HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
TSX=""
if [ -x node_modules/.bin/tsx ]; then
  TSX="node_modules/.bin/tsx"
elif [ -x "$HOOK_DIR/../../node_modules/.bin/tsx" ]; then
  TSX="$HOOK_DIR/../../node_modules/.bin/tsx"
fi

# Targeted cargo-test plan: computed only when the rust gate fired, so
# rust-less pushes pay nothing. Modes: skip | packages | workspace
# | unavailable (no tsx) | unknown (plan computation failed).
test_mode="skip"
test_pkgs=""
if [ "$run_rust" = 1 ]; then
  if [ "$full_gate" = 1 ]; then
    test_mode="workspace"
  elif [ -n "$TSX" ]; then
    plan_out=$(printf '%s' "$changed" | "$TSX" "$HOOK_DIR/rust-test-targets.ts")
    case "$plan_out" in
      skip) test_mode="skip" ;;
      workspace) test_mode="workspace" ;;
      packages\ *) test_mode="packages"; test_pkgs="${plan_out#packages }" ;;
      *) test_mode="unknown" ;;
    esac
  else
    test_mode="unavailable"
  fi
fi

if [ "${FRESHELL_PREPUSH_DEBUG:-0}" = "1" ]; then
  echo "pre-push[debug]: full_gate=$full_gate run_rust=$run_rust run_ts=$run_ts test_mode=$test_mode test_pkgs=$test_pkgs" >&2
  printf '%s' "$changed" | sed 's/^/  changed: /' >&2
  exit 0
fi

if [ "$run_rust" = 0 ] && [ "$run_ts" = 0 ]; then
  [ -n "$changed" ] && echo "pre-push: no rust/ts files changed — skipping checks" >&2
  exit 0
fi

fail() {
  echo "pre-push: FAILED — $1" >&2
  echo "pre-push: fix and push again, or bypass with: git push --no-verify" >&2
  exit 1
}

if [ "$run_rust" = 1 ]; then
  # cargo can live in ~/.cargo/bin, which stripped-environment hook contexts
  # (ssh, agents, IDEs, cron) don't always carry on PATH.
  if ! command -v cargo >/dev/null 2>&1 && [ -d "$HOME/.cargo/bin" ]; then
    PATH="$HOME/.cargo/bin:$PATH"
  fi
  if command -v cargo >/dev/null 2>&1; then
    echo "pre-push: rust gate — cargo fmt --all --check" >&2
    cargo fmt --all --check || fail "cargo fmt --all --check"
    echo "pre-push: rust gate — cargo clippy --workspace (a few minutes warm; longer cold)" >&2
    cargo clippy --workspace --exclude freshell-tauri --all-targets -- -D warnings \
      || fail "cargo clippy --workspace --all-targets -- -D warnings"

    # Targeted cargo test lane — the check that PR #795 slipped past: the
    # author's push contained 11 failing freshagent unit tests, but nothing
    # between commit and main ran cargo test. Runs the changed crates plus
    # their workspace dependents; workspace-wide when the change is
    # root-level (Cargo.lock, toolchain) or the base is unknown.
    case "$test_mode" in
      unavailable)
        echo "pre-push: node_modules missing (no tsx) — SKIPPING rust test lane (npm install to enforce)" >&2
        ;;
      unknown)
        fail "rust test plan could not be computed (scripts/hooks/rust-test-targets.ts)"
        ;;
      workspace)
        echo "pre-push: rust gate — cargo test --workspace --exclude freshell-tauri (the long one)" >&2
        cargo test --workspace --exclude freshell-tauri --locked \
          || fail "cargo test --workspace --exclude freshell-tauri --locked"
        ;;
      packages)
        pkgs_args=""
        for p in $test_pkgs; do pkgs_args="$pkgs_args -p $p"; done
        echo "pre-push: rust gate — targeted cargo test:$pkgs_args" >&2
        cargo test --locked $pkgs_args || fail "cargo test$pkgs_args"
        ;;
      skip)
        ;;
    esac
  else
    echo "pre-push: cargo not on PATH (~/.cargo/bin tried) — SKIPPING rust gate" >&2
  fi
fi

if [ "$run_ts" = 1 ]; then
  if [ ! -e node_modules/.bin/tsc ]; then
    echo "pre-push: node_modules missing (no tsc) — SKIPPING typecheck (npm install to enforce)" >&2
  else
    # npm (and node) can live in nvm, which stripped-environment hook contexts
    # (ssh, agents, IDEs, cron) don't always load — source the loader if absent.
    if ! command -v npm >/dev/null 2>&1; then
      [ -s "$HOME/.nvm/nvm.sh" ] && \. "$HOME/.nvm/nvm.sh" >/dev/null 2>&1
    fi
    if command -v npm >/dev/null 2>&1; then
      echo "pre-push: ts gate — npm run typecheck" >&2
      npm run --silent typecheck || fail "npm run typecheck"
    else
      echo "pre-push: npm not on PATH (nvm loader tried) — SKIPPING typecheck" >&2
    fi
  fi
fi

echo "pre-push: OK" >&2
exit 0
